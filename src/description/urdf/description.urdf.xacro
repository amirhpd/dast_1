<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dast_1">

    <!-- VARIABLES -->
    <xacro:arg name="is_sim" default="true"/>
    <xacro:property name="path" value="package://description/meshes" />
    <xacro:property name="scale" value="0.01 0.01 0.01" />
    <xacro:property name="PI" value="3.14159265359" />
    <!-- Joint effort limits: each drive's stall torque at its supply, in real N*m, from
         mechlint.yaml via `mechlint torque` (all bench-measured, `low` confidence).
         Gazebo reads this decimetre model as metres, so every lever arm, and every
         torque gravity puts on a joint, is ten times the real one. arm_joint multiplies
         by effort_scale to match; with the real values the shoulder cannot hold the
         arm up in sim. -->
    <xacro:property name="effort_scale" value="10.0" />
    <xacro:property name="effort_ds3240" value="2.36" />    <!-- DS3240MG, 6 V -->
    <xacro:property name="effort_ds51150" value="11.04" />  <!-- DS51150, 12 V -->
    <xacro:property name="effort_mg996r" value="1.10" />    <!-- MG996R, 6 V -->
    <xacro:property name="velocity" value="10.0" />

    <!-- Kinect mount, eye-to-hand. Pose of kinect_link in base_link.
         BEWARE: this model is not in metres. The meshes are millimetres scaled by
         0.01, so one unit here is one decimetre, and the arm's 0.71 m reach shows
         up as 7.07. The tape-measured mount (x -0.9, y 0.31, z 0.39 m) is
         therefore multiplied by ten below.
         Pitch is positive because REP-103 rotates +x toward -z about +y, so
         positive pitch is nose *down*, the opposite sign to the Kinect motor's
         own convention, where the same 16 degrees of head-down tilt is -16. -->
    <xacro:property name="kinect_xyz" value="-9.0 3.1 3.9" />
    <xacro:property name="kinect_rpy" value="0 0.279 0" />

    <!-- Matched to the calibrated intrinsics in kinect/config/kinect_rgb.yaml:
         2*atan(640/(2*549.996)) = 60.4 degrees. Clip planes are the sensor's real
         usable range, 0.5..4.0 m, in this model's decimetres. -->
    <xacro:property name="kinect_hfov" value="1.0542" />
    <xacro:property name="kinect_clip_near" value="5.0" />
    <xacro:property name="kinect_clip_far" value="40.0" />

    <!-- One macro per link, computed from the meshes and mechlint.yaml by
         `mechlint inertia -w src/description/urdf/`. Generated: do not edit it, re-run
         the command. Lengths in it are decimetres, like the rest of this file. -->
    <xacro:include filename="$(find description)/urdf/inertials.xacro" />

    <!-- One link of the arm: meshes/<mesh>.stl (in mm, origin on the link's own joint
         axis) as both visual and collision. `rpy` rotates both. To use a simplified
         collision mesh, pass collision:=<name> for meshes/<name>.stl; it must enclose
         the visual mesh, see CLAUDE.md. -->
    <xacro:macro name="arm_link" params="name mesh collision:='' rpy:='0 0 0'">
        <link name="${name}">
            <!-- mechlint_inertial_<name>, from inertials.xacro -->
            <xacro:call macro="mechlint_inertial_${name}"/>
            <visual>
                <origin rpy="${rpy}" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="${path}/${mesh}.stl" scale="${scale}"/>
                </geometry>
            </visual>
            <collision>
                <origin rpy="${rpy}" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="${path}/${collision if collision else mesh}.stl" scale="${scale}"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

    <!-- One revolute joint. Offsets are the CAD joint positions (mm) divided by 100. -->
    <xacro:macro name="arm_joint" params="name parent child xyz axis effort">
        <joint name="${name}" type="revolute">
            <parent link="${parent}"/>
            <child link="${child}"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <axis xyz="${axis}"/>
            <limit lower="-${PI / 2}" upper="${PI / 2}"
                   effort="${effort * effort_scale}" velocity="${velocity}"/>
        </joint>
    </xacro:macro>

    <!-- LINKS -->
    <link name="world"/>

    <xacro:arm_link name="base_link"   mesh="base_1"/>
    <xacro:arm_link name="base_2_link" mesh="base_2"/>
    <xacro:arm_link name="link_1"      mesh="link_1"/>
    <xacro:arm_link name="link_2"      mesh="link_2"/>
    <xacro:arm_link name="link_3"      mesh="link_3" rpy="0 0 ${PI/2}"/>
    <xacro:arm_link name="link_4"      mesh="link_4"/>
    <xacro:arm_link name="link_5"      mesh="link_5"/>
    <xacro:arm_link name="tip_link"    mesh="tip"/>

    <!-- End-effector point, at the far end of tip.stl. MoveIt plans for this frame. -->
    <link name="tip"/>

    <!-- JOINTS -->
    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <xacro:arm_joint name="joint_1" parent="base_link"   child="base_2_link" xyz="0 0 1.685"            axis="0 0 1" effort="${effort_ds3240}"/>
    <xacro:arm_joint name="joint_2" parent="base_2_link" child="link_1"      xyz="0 0 0"                axis="0 1 0" effort="${effort_ds51150}"/>
    <xacro:arm_joint name="joint_3" parent="link_1"      child="link_2"      xyz="0 -0.084 1.37"        axis="0 1 0" effort="${effort_ds51150}"/>
    <xacro:arm_joint name="joint_4" parent="link_2"      child="link_3"      xyz="-0.2725 -0.084 1.06"  axis="0 0 1" effort="${effort_mg996r}"/>
    <xacro:arm_joint name="joint_5" parent="link_3"      child="link_4"      xyz="0 0 0.91"             axis="1 0 0" effort="${effort_mg996r}"/>
    <xacro:arm_joint name="joint_6" parent="link_4"      child="link_5"      xyz="-0.025 0.0175 -0.27"  axis="0 1 0" effort="${effort_mg996r}"/>

    <joint name="virtual_joint_tip_link" type="fixed">
        <parent link="link_5"/>
        <child link="tip_link"/>
        <origin xyz="0 0 0.71" rpy="0 0 0"/>
    </joint>

    <joint name="virtual_joint_tip" type="fixed">
        <parent link="tip_link"/>
        <child link="tip"/>
        <origin xyz="0 0 1.666" rpy="0 0 0"/>
    </joint>

    <!-- KINECT -->
    <!-- Present in both modes: the real driver and the simulated sensor publish
         the same topics in the same frames, so nothing downstream can tell them
         apart. Only the sensor block below is simulation-only. -->
    <link name="kinect_link">
        <xacro:mechlint_inertial_kinect_link/>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.4 2.8 0.7"/>
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.4 2.8 0.7"/>
            </geometry>
        </collision>
    </link>

    <!-- Images and clouds are published in the optical convention: z forward out
         of the lens, x right, y down. kinect_link itself is the ordinary robot
         convention, x forward. -->
    <link name="kinect_rgb_optical_frame"/>

    <joint name="kinect_joint" type="fixed">
        <parent link="base_link"/>
        <child link="kinect_link"/>
        <origin xyz="${kinect_xyz}" rpy="${kinect_rpy}"/>
    </joint>

    <joint name="kinect_optical_joint" type="fixed">
        <parent link="kinect_link"/>
        <child link="kinect_rgb_optical_frame"/>
        <origin xyz="0 0 0" rpy="-${PI/2} 0 -${PI/2}"/>
    </joint>

    <xacro:if value="$(arg is_sim)">
        <gazebo reference="kinect_link">
            <sensor name="kinect" type="rgbd_camera">
                <camera>
                    <horizontal_fov>${kinect_hfov}</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>${kinect_clip_near}</near>
                        <far>${kinect_clip_far}</far>
                    </clip>
                </camera>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>
                <topic>kinect</topic>
                <!-- kinect_link, not the optical frame. Gazebo renders along the
                     sensor link's +x and emits the cloud in that same frame, and
                     gz_frame_id only labels the message, it does not rotate the
                     data. Naming the optical frame here produced a cloud whose
                     depth axis was x while every consumer read it as z, which put
                     the ground plane 16 units underground. The real driver does
                     publish the optical convention; both are correct in their own
                     frame and TF reconciles them. -->
                <gz_frame_id>kinect_link</gz_frame_id>
            </sensor>
        </gazebo>
    </xacro:if>

    <!-- Gazebo (for Humble)-->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find controller)/config/controller.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- Control -->
    <xacro:include filename="$(find description)/urdf/control.xacro" />

</robot>