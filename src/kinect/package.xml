<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kinect</name>
  <version>0.0.0</version>
  <description>Standalone Kinect v1 (Xbox 360) driver, used to verify the sensor reaches ROS 2</description>
  <maintainer email="ahpd1068@yahoo.com">amir</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>camera_calibration_parsers</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>libfreenect-dev</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
